{"id":"wf-001","description":"High-confidence invoice approval workflow extracted from Slack","input":{"tenantId":"tenant_day1","events":[{"provider":"SLACK","actor":"alice@acme.com","tool":"Slack","action":"message_sent","channel":"#invoices","occurredAt":"2026-01-05T09:00:00Z","payload":{"text":"Invoice INV-2024 received from vendor, routing for approval"}},{"provider":"SLACK","actor":"bob@acme.com","tool":"Slack","action":"message_sent","channel":"#invoices","occurredAt":"2026-01-05T09:15:00Z","payload":{"text":"Reviewed INV-2024, approving"}},{"provider":"SLACK","actor":"alice@acme.com","tool":"Slack","action":"message_sent","channel":"#invoices","occurredAt":"2026-01-05T09:20:00Z","payload":{"text":"INV-2024 approved, forwarding to finance"}},{"provider":"GMAIL","actor":"alice@acme.com","tool":"Gmail","action":"email_sent","occurredAt":"2026-01-05T09:22:00Z","payload":{"subject":"RE: Invoice INV-2024 Approved","to":"finance@acme.com"}}]},"expected":{"workflowKey":"invoice-approval","workflowName":"Invoice Approval","confidence":{"min":0.80,"max":1.0},"avgMinutesPerRun":{"min":15,"max":30},"monthlyRuns":{"min":8,"max":20},"nodes":[{"actor":"alice@acme.com","tool":"Slack","action":"message_sent","sequence":1},{"actor":"bob@acme.com","tool":"Slack","action":"message_sent","sequence":2},{"actor":"alice@acme.com","tool":"Slack","action":"message_sent","sequence":3},{"actor":"alice@acme.com","tool":"Gmail","action":"email_sent","sequence":4}],"edges":[{"fromSequence":1,"toSequence":2},{"fromSequence":2,"toSequence":3},{"fromSequence":3,"toSequence":4}]},"label":"HIGH_CONFIDENCE","tags":["cross-provider","sequential","approval-chain"]}
