{"id":"fs-007","description":"HLC+ROI integration: high-feasibility invoice approval with positive ROI","input":{"workflowId":"wf-001","tenantId":"tenant_day1","hlcRoiInput":{"avgMinutesPerRun":22,"monthlyRuns":15,"blendedHourlyRate":75,"feasibilityScore":0.88,"implementationCost":12000,"annualPlatformCost":3600}},"expected":{"annualLaborCost":{"min":3000,"max":4500},"annualNetSavings":{"min":-2000,"max":3000},"paybackMonths":{"min":4,"max":36},"automationCoverage":{"min":0.80,"max":1.0},"roiScore":{"min":0.50,"max":1.0}},"label":"ROI_POSITIVE","formula_note":"annualLaborCost = (monthlyRuns*12) * (avgMinutesPerRun/60) * blendedHourlyRate * feasibilityScore","tags":["roi-positive","payback-feasible"]}
{"id":"fs-008","description":"HLC+ROI integration: low-feasibility bug triage — negative ROI expected","input":{"workflowId":"wf-003","tenantId":"tenant_day1","hlcRoiInput":{"avgMinutesPerRun":720,"monthlyRuns":3,"blendedHourlyRate":75,"feasibilityScore":0.32,"implementationCost":20000,"annualPlatformCost":6000}},"expected":{"annualLaborCost":{"min":800,"max":2500},"annualNetSavings":{"min":-30000,"max":-5000},"paybackMonths":null,"automationCoverage":{"min":0.20,"max":0.45},"roiScore":{"min":0.0,"max":0.25}},"label":"ROI_NEGATIVE","formula_note":"paybackMonths=null when annualNetSavings <= 0","tags":["roi-negative","no-payback","not-recommended"]}
