{"id":"fs-001","description":"High feasibility: stable, low-actor, low-tool, low-variance invoice approval","input":{"workflowId":"wf-001","tenantId":"tenant_day1","eventCount30d":120,"uniqueActorCount":2,"uniqueToolCount":2,"varianceRatio":0.08,"avgMinutesPerRun":22,"monthlyRuns":15},"expected":{"feasibilityScore":{"min":0.80,"max":1.0},"confidence":{"min":0.80,"max":1.0},"breakdown":{"processStability":{"min":0.80,"max":1.0},"integrationComplexity":{"min":0.75,"max":1.0},"dataAvailability":{"min":0.80,"max":1.0},"exceptionRisk":{"min":0.80,"max":1.0}},"recommendationStatus":"RECOMMENDED","reviewStatus":"AUTO_APPROVED"},"label":"HIGH_FEASIBILITY","rationale_required":false,"tags":["low-actor-count","low-variance","high-event-volume","automatable"]}
