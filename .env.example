# ─── Core ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
WEB_PORT=3001
API_BASE_URL=http://localhost:3000

# Comma-separated list of allowed CORS origins for the API server.
# In production, set this to your Vercel deployment URL.
CORS_ORIGIN=http://localhost:3001

# ─── Database & Cache ──────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nexusos
REDIS_URL=redis://localhost:6379

# ─── Security — REQUIRED ───────────────────────────────────────────────────────
# JWT signing secret. Use a random 64-character hex string in production.
# Generate: openssl rand -hex 32
JWT_SECRET=replace-with-long-secret

# AES-256-GCM key used to encrypt OAuth access/refresh tokens at rest.
# Generate: openssl rand -hex 32
# WARNING: changing this key after tokens are stored requires re-authorising all connectors.
TOKEN_ENCRYPTION_KEY=replace-with-32-byte-hex-secret

# ─── LLM ───────────────────────────────────────────────────────────────────────
# At least one AI provider key is required for AI analysis, blueprint generation,
# agent reasoning, and the chatbot. If both are set, Anthropic takes priority.

# Option A (recommended): Anthropic Claude
ANTHROPIC_API_KEY=
# Optional: override the default model (claude-sonnet-4-20250514)
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Option B: OpenAI (or OpenAI-compatible endpoint)
OPENAI_API_KEY=
# Optional: override the default model (gpt-4o)
OPENAI_MODEL=gpt-4o
# Optional: custom OpenAI-compatible base URL (e.g. Azure OpenAI, local Ollama)
OPENAI_BASE_URL=

# ─── OAuth — Slack ─────────────────────────────────────────────────────────────
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:3000/connectors/slack/callback
SLACK_READ_SCOPES=channels:read,channels:history,groups:read,groups:history
SLACK_CHANNEL_IDS=
SLACK_MAX_RETRIES=4
SLACK_BACKOFF_MS=350

# ─── OAuth — Gmail (Google Workspace) ─────────────────────────────────────────
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:3000/connectors/gmail/callback
GMAIL_READ_SCOPES=https://www.googleapis.com/auth/gmail.readonly
GMAIL_QUERY=
GMAIL_PAGE_SIZE=100
GMAIL_MAX_RETRIES=4
GMAIL_BACKOFF_MS=350

# ─── OAuth — GitHub ────────────────────────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3000/connectors/github/callback
GITHUB_SCOPES=repo read:user

# ─── OAuth — Notion ────────────────────────────────────────────────────────────
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=http://localhost:3000/connectors/notion/callback

# ─── OAuth — Linear ────────────────────────────────────────────────────────────
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_REDIRECT_URI=http://localhost:3000/connectors/linear/callback
LINEAR_SCOPES=read

# ─── OAuth — Jira (Atlassian) ─────────────────────────────────────────────────
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
JIRA_REDIRECT_URI=http://localhost:3000/connectors/jira/callback
JIRA_SCOPES=read:jira-data read:jira-user offline_access

# ─── OAuth — Google Calendar ───────────────────────────────────────────────────
GCAL_CLIENT_ID=
GCAL_CLIENT_SECRET=
GCAL_REDIRECT_URI=http://localhost:3000/connectors/gcal/callback
GCAL_SCOPES=https://www.googleapis.com/auth/calendar.readonly

# ─── ROI formula constants ─────────────────────────────────────────────────────
# Used by pipeline.service.ts and workers/src/index.ts
BLENDED_HOURLY_RATE=95
IMPLEMENTATION_COST_DEFAULT=18000
ANNUAL_PLATFORM_COST=4800

# ─── Feature flags ─────────────────────────────────────────────────────────────
# Set to true to enable LLM-powered feasibility rationale (requires OPENAI_API_KEY)
ENABLE_LLM_RATIONALE=false
