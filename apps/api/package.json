{
  "name": "@nexus/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "pretest": "pnpm --filter @nexus/contracts build && pnpm --filter @nexus/shared build",
    "prebuild": "pnpm --filter @nexus/contracts build && pnpm --filter @nexus/shared build",
    "dev": "ts-node --swc -r reflect-metadata -r dotenv/config src/main.ts dotenv_config_path=.env",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "lint": "echo 'No lint configured for api'",
    "test": "vitest run",
    "test:smoke": "vitest run test/smoke.test.ts test/smoke-flow.test.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^10.4.15",
    "@nexus/contracts": "workspace:*",
    "@nexus/shared": "workspace:*",
    "@prisma/client": "^6.3.1",
    "ajv": "^8.17.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.41.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "groq-sdk": "^0.37.0",
    "ioredis": "^5.4.2",
    "jose": "^6.1.3",
    "openai": "^6.24.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@swc/core": "^1.15.13",
    "@swc/helpers": "^0.5.19",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^22.10.2",
    "@types/passport-jwt": "^4.0.1",
    "prisma": "^6.3.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}